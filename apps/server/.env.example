# Saved settings from the UI take precedence; these values are the fallback.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# OpenAI-compatible Chat Completions endpoint. Keep credentials on the server.
# Use the provider's actual model identifier. No default model is assumed.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=45000
# json_schema (strict structured output), or json_object for compatible providers.
# Both modes are validated with Zod after the response.
AI_RESPONSE_FORMAT=json_schema

# Demo is requested explicitly per analysis; live mode NEVER falls back to demo.

# Optional proxy for model requests; use your actual proxy address and restart.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
