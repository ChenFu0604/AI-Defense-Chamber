# Saved settings from the UI take precedence; these values are the fallback.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# OpenAI-compatible Chat Completions endpoint. Keep credentials on the server.
# Use the provider's actual model identifier. No default model is assumed.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=120000
# json_schema (strict structured output), or json_object for compatible providers.
# Both modes are validated with Zod after the response.
AI_RESPONSE_FORMAT=json_schema

# Optional, independent OpenAI-compatible Embeddings service. UI-saved settings
# override these values. Enabling sends project text chunks and search queries
# to this endpoint; no chat model/key is implicitly reused.
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=120000
# Leave empty to use provider defaults; optional dimensions support varies.
EMBEDDING_DIMENSIONS=
# Cosine candidate cutoff (0..1), a ranking signal rather than factual confidence.
EMBEDDING_MIN_SIMILARITY=0.35

# Demo is requested explicitly per analysis; live mode NEVER falls back to demo.

# Optional proxy for model requests; use your actual proxy address and restart.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
